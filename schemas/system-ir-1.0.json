{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repodocs.dev/schemas/system-ir-1.0.json",
  "title": "RepoDocs System IR",
  "type": "object",
  "required": ["ir_version", "project", "snapshots", "nodes", "relationships", "evidence", "claims", "provenance"],
  "properties": {
    "ir_version": {"const": "1.0"},
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "snapshots": {"type": "array", "items": {"$ref": "#/$defs/snapshot"}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "provenance": {
      "type": "object",
      "required": ["engine", "engine_version", "analyzer", "analyzer_version", "snapshot_mode"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "analyzer": {"type": "string", "minLength": 1},
        "analyzer_version": {"type": "string", "minLength": 1},
        "snapshot_mode": {"$ref": "#/$defs/snapshot_mode"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "snapshot_mode": {
      "enum": ["local", "pinned"],
      "description": "local: working tree including uncommitted changes. pinned: clean checkout of one exact commit."
    },
    "revision_kind": {
      "enum": ["commit", "content"],
      "description": "commit: the revision is a Git commit SHA that exactly describes the scanned content. content: the revision is a fingerprint of the scanned working tree."
    },
    "snapshot": {
      "type": "object",
      "required": [
        "repository_id",
        "path",
        "role",
        "snapshot_mode",
        "vcs",
        "git_revision",
        "git_branch",
        "head_state",
        "git_path_prefix",
        "working_tree_state",
        "git_status_fingerprint",
        "pinned_revision",
        "content_fingerprint",
        "revision_kind",
        "revision",
        "files"
      ],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1, "description": "Repository path as configured, not resolved, so the IR is stable across machines."},
        "role": {"enum": ["source", "destination"]},
        "snapshot_mode": {"$ref": "#/$defs/snapshot_mode"},
        "vcs": {"enum": ["git", null]},
        "git_revision": {"type": ["string", "null"]},
        "git_branch": {"type": ["string", "null"]},
        "head_state": {"enum": ["attached", "detached", null]},
        "git_path_prefix": {"type": ["string", "null"], "description": "Path of the registered root inside its Git repository; empty when they coincide."},
        "working_tree_state": {"enum": ["clean", "dirty", "non-git"]},
        "git_status_fingerprint": {"type": ["string", "null"]},
        "pinned_revision": {"type": ["string", "null"]},
        "content_fingerprint": {"type": "string", "minLength": 1},
        "revision_kind": {"$ref": "#/$defs/revision_kind"},
        "revision": {"type": "string", "minLength": 1, "description": "What evidence for this snapshot resolves to."},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "size", "content_hash", "language"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "size": {"type": "integer", "minimum": 0},
              "content_hash": {"type": "string", "minLength": 1},
              "language": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "name", "attributes", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "attributes": {"type": "object"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": ["id", "type", "source", "target", "classification", "confidence", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "classification": {"enum": ["observed", "inferred", "proposed"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["id", "repository_id", "path", "content_hash", "revision", "revision_kind", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repository_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "revision_kind": {"$ref": "#/$defs/revision_kind"},
        "kind": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": ["id", "text", "classification", "confidence", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "classification": {"enum": ["observed", "inferred", "proposed"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
