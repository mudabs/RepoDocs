{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repodocs.dev/schemas/system-ir-1.0.json",
  "title": "RepoDocs System IR",
  "type": "object",
  "required": ["ir_version", "project", "snapshots", "nodes", "relationships", "evidence", "claims", "limitations", "candidates", "provenance"],
  "properties": {
    "ir_version": {"const": "1.0"},
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "snapshots": {"type": "array", "items": {"$ref": "#/$defs/snapshot"}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "limitations": {
      "type": "array",
      "description": "Constructs an analyzer observed but did not turn into facts: dynamic routing, reflection, generated code, runtime configuration, unsupported constructs or languages, unreadable sources, ambiguous references.",
      "items": {"$ref": "#/$defs/limitation"}
    },
    "provenance": {
      "type": "object",
      "required": ["engine", "engine_version", "analyzer", "analyzer_version", "analyzers", "snapshot_mode"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "analyzer": {"type": "string", "minLength": 1, "description": "The always-on basic analyzer."},
        "analyzer_version": {"type": "string", "minLength": 1},
        "analyzers": {
          "type": "array",
          "description": "Every analyzer that was offered each source repository, with the repositories where it detected its framework and ran.",
          "items": {
            "type": "object",
            "required": ["name", "version", "repositories"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "repositories": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": true
          }
        },
        "snapshot_mode": {"$ref": "#/$defs/snapshot_mode"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["id", "type", "source", "target", "status", "classification", "confidence", "reasons", "evidence_ids", "snapshots", "attributes"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"const": "http"},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "status": {"enum": ["candidate", "confirmed", "rejected", "stale"]},
        "confirmation": {
          "type": "object", "required": ["decision", "snapshots"], "additionalProperties": false,
          "description": "The recorded decision and the revisions it was made against. Present unless status is candidate; a stale status means the evidence changed since.",
          "properties": {
            "decision": {"enum": ["confirmed", "rejected"]},
            "note": {"type": "string"},
            "snapshots": {
              "type": "object", "minProperties": 1,
              "additionalProperties": {
                "type": "object", "required": ["revision", "revision_kind"], "additionalProperties": false,
                "properties": {
                  "revision": {"type": "string", "minLength": 1},
                  "revision_kind": {"$ref": "#/$defs/revision_kind"}
                }
              }
            }
          }
        },
        "classification": {"const": "inferred"},
        "confidence": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {
          "enum": ["method-match", "literal-path-match", "template-path-match", "declared-server-origin-match"]
        }},
        "evidence_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "snapshots": {
          "type": "object", "minProperties": 2, "maxProperties": 2,
          "additionalProperties": {
            "type": "object", "required": ["revision", "revision_kind"], "additionalProperties": false,
            "properties": {
              "revision": {"type": "string", "minLength": 1},
              "revision_kind": {"$ref": "#/$defs/revision_kind"}
            }
          }
        },
        "attributes": {
          "type": "object", "required": ["method", "path", "origin_supported"], "additionalProperties": false,
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "origin_supported": {"type": "boolean"}
          }
        }
      }
    },
    "snapshot_mode": {
      "enum": ["local", "pinned"],
      "description": "local: working tree including uncommitted changes. pinned: clean checkout of one exact commit."
    },
    "revision_kind": {
      "enum": ["commit", "content"],
      "description": "commit: the revision is a Git commit SHA that exactly describes the scanned content. content: the revision is a fingerprint of the scanned working tree."
    },
    "snapshot": {
      "type": "object",
      "required": [
        "repository_id",
        "path",
        "role",
        "snapshot_mode",
        "vcs",
        "git_revision",
        "git_branch",
        "head_state",
        "git_path_prefix",
        "working_tree_state",
        "git_status_fingerprint",
        "pinned_revision",
        "content_fingerprint",
        "revision_kind",
        "revision",
        "files"
      ],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1, "description": "Repository path as configured, not resolved, so the IR is stable across machines."},
        "role": {"enum": ["source", "destination"]},
        "snapshot_mode": {"$ref": "#/$defs/snapshot_mode"},
        "vcs": {"enum": ["git", null]},
        "git_revision": {"type": ["string", "null"]},
        "git_branch": {"type": ["string", "null"]},
        "head_state": {"enum": ["attached", "detached", null]},
        "git_path_prefix": {"type": ["string", "null"], "description": "Path of the registered root inside its Git repository; empty when they coincide."},
        "working_tree_state": {"enum": ["clean", "dirty", "non-git"]},
        "git_status_fingerprint": {"type": ["string", "null"]},
        "pinned_revision": {"type": ["string", "null"]},
        "content_fingerprint": {"type": "string", "minLength": 1},
        "revision_kind": {"$ref": "#/$defs/revision_kind"},
        "revision": {"type": "string", "minLength": 1, "description": "What evidence for this snapshot resolves to."},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "size", "content_hash", "language"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "size": {"type": "integer", "minimum": 0},
              "content_hash": {"type": "string", "minLength": 1},
              "language": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "name", "attributes", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "attributes": {"type": "object"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": ["id", "type", "source", "target", "classification", "confidence", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "classification": {"enum": ["observed", "inferred", "proposed"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "attributes": {"type": "object", "description": "Optional typed details, for example the member a dependency is injected through or the JPA association kind."}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["id", "repository_id", "path", "content_hash", "revision", "revision_kind", "kind", "analyzer"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repository_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "minLength": 1, "description": "Hash of the whole file the evidence lives in, also for spans."},
        "revision": {"type": "string", "minLength": 1},
        "revision_kind": {"$ref": "#/$defs/revision_kind"},
        "kind": {"enum": ["file", "span"], "description": "file: the whole file. span: a line range inside it."},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "symbol": {"type": ["string", "null"], "description": "Qualified symbol the span declares, where known."},
        "analyzer": {"type": "string", "minLength": 1, "description": "The analyzer that recorded this evidence."}
      },
      "if": {"properties": {"kind": {"const": "span"}}},
      "then": {"required": ["line_start", "line_end"]},
      "additionalProperties": true
    },
    "limitation": {
      "type": "object",
      "required": ["id", "repository_id", "analyzer", "kind", "message", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repository_id": {"type": "string", "minLength": 1},
        "analyzer": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "dynamic-routing",
            "reflection",
            "generated-code",
            "runtime-configuration",
            "unsupported-construct",
            "unsupported-language",
            "unreadable-source",
            "ambiguous-reference"
          ]
        },
        "message": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": ["id", "text", "classification", "confidence", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "classification": {"enum": ["observed", "inferred", "proposed"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
