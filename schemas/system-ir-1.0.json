{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repodocs.dev/schemas/system-ir-1.0.json",
  "title": "RepoDocs System IR",
  "type": "object",
  "required": ["ir_version", "project", "snapshots", "nodes", "relationships", "evidence", "claims", "provenance"],
  "properties": {
    "ir_version": {"const": "1.0"},
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "snapshots": {"type": "array", "items": {"$ref": "#/$defs/snapshot"}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true,
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": ["repository_id", "path", "revision_kind", "working_tree_state", "content_fingerprint", "files"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "revision_kind": {"type": "string", "minLength": 1},
        "git_revision": {"type": ["string", "null"]},
        "working_tree_state": {"type": "string", "minLength": 1},
        "git_status_fingerprint": {"type": ["string", "null"]},
        "content_fingerprint": {"type": "string", "minLength": 1},
        "files": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "name", "attributes", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "attributes": {"type": "object"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": ["id", "type", "source", "target", "classification", "confidence", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "classification": {"enum": ["observed", "inferred", "proposed"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["id", "repository_id", "path", "content_hash", "revision", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repository_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": ["id", "text", "classification", "confidence", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "classification": {"enum": ["observed", "inferred", "proposed"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
