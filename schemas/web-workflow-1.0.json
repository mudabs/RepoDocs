{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repodocs.dev/schemas/web-workflow-1.0.json",
  "title": "Local web workflow contract: requests, jobs and API errors",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/job"
    },
    {
      "$ref": "#/$defs/api_error"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "request"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "deterministic",
            "architecture"
          ]
        },
        "provider_session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "consent_receipt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "overview",
              "components",
              "erd"
            ]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_requests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "max_total_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "max_cost_microunits": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "enum": [
                "USD",
                null
              ]
            }
          },
          "required": [
            "max_requests",
            "max_total_tokens",
            "max_cost_microunits",
            "currency"
          ]
        },
        "refresh": {
          "type": "boolean"
        }
      },
      "required": [
        "contract_version",
        "kind",
        "workspace_id",
        "idempotency_key",
        "mode",
        "provider_session_id",
        "context_hash",
        "consent_receipt_id",
        "views",
        "limits"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "architecture"
              }
            }
          },
          "then": {
            "properties": {
              "provider_session_id": {
                "type": "string",
                "minLength": 1
              },
              "context_hash": {
                "type": "string",
                "minLength": 1
              },
              "limits": {
                "properties": {
                  "max_total_tokens": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_requests": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "deterministic"
              }
            }
          },
          "then": {
            "properties": {
              "provider_session_id": {
                "type": "null"
              },
              "consent_receipt_id": {
                "type": "null"
              },
              "limits": {
                "properties": {
                  "max_requests": {
                    "const": 0
                  },
                  "max_cost_microunits": {
                    "const": 0
                  }
                }
              },
              "refresh": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "limits": {
                "properties": {
                  "max_cost_microunits": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "limits": {
                "properties": {
                  "currency": {
                    "const": "USD"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "job"
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "queued",
            "preflight",
            "running",
            "succeeded",
            "partial",
            "budget-exhausted",
            "cancelled",
            "failed",
            "stale",
            "interrupted"
          ]
        },
        "stage": {
          "enum": [
            "queued",
            "scan",
            "context",
            "discover",
            "generate",
            "validate",
            "finished"
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        },
        "result": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/result"
            }
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "cost_microunits": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "enum": [
                "USD",
                null
              ]
            },
            "accounting": {
              "enum": [
                "known",
                "estimated",
                "unknown"
              ]
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "cost_microunits",
            "currency",
            "accounting"
          ]
        },
        "budget": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/budget"
            }
          ]
        }
      },
      "required": [
        "contract_version",
        "kind",
        "job_id",
        "workspace_id",
        "sequence",
        "state",
        "stage",
        "error",
        "result",
        "usage"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "const": "finished"
              },
              "error": {
                "type": "null"
              },
              "result": {
                "allOf": [
                  {
                    "$ref": "#/$defs/result"
                  },
                  {
                    "properties": {
                      "completeness": {
                        "const": "complete"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "partial",
                  "budget-exhausted",
                  "cancelled"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/error"
              },
              "result": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/result"
                      },
                      {
                        "properties": {
                          "completeness": {
                            "const": "partial"
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "failed",
                  "interrupted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/error"
              },
              "result": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "stale"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "allOf": [
                  {
                    "$ref": "#/$defs/error"
                  },
                  {
                    "properties": {
                      "code": {
                        "const": "stale-source"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "queued",
                  "preflight",
                  "running"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              },
              "result": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "budget-exhausted"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "allOf": [
                  {
                    "$ref": "#/$defs/error"
                  },
                  {
                    "properties": {
                      "code": {
                        "const": "budget-exhausted"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "allOf": [
                  {
                    "$ref": "#/$defs/error"
                  },
                  {
                    "properties": {
                      "code": {
                        "const": "cancelled"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "interrupted"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "allOf": [
                  {
                    "$ref": "#/$defs/error"
                  },
                  {
                    "properties": {
                      "code": {
                        "const": "interrupted"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "preflight"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "enum": [
                  "scan",
                  "context"
                ]
              }
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "budget-exhausted",
            "provider-failure",
            "cancelled",
            "stale-source",
            "interrupted",
            "invalid-request",
            "consent-required",
            "operation-failure"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "view_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ir_hash": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "completeness",
        "view_hash",
        "source_ir_hash",
        "artifact_ids",
        "warnings"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "description": "Budget diagnostics of an architecture job. Unknown values are null, never zero.",
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "count_requests": {
          "type": "integer",
          "minimum": 0
        },
        "remaining_requests": {
          "type": "integer",
          "minimum": 0
        },
        "remaining_total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "remaining_cost_microunits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_estimated_cost_microunits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "usage_complete": {
          "type": "boolean"
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "stop_message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "requests",
        "count_requests",
        "remaining_requests",
        "remaining_total_tokens",
        "remaining_cost_microunits",
        "max_estimated_cost_microunits",
        "usage_complete",
        "stop_reason",
        "stop_message"
      ]
    },
    "api_error": {
      "type": "object",
      "additionalProperties": false,
      "description": "The body of every non-2xx response of the HTTP adapter.",
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "invalid-request",
                "session-required",
                "access-denied",
                "consent-required",
                "not-found",
                "conflict",
                "stale-preview",
                "stale-artifact",
                "busy",
                "queue-full",
                "too-large",
                "workspace-failure",
                "operation-failure",
                "unavailable"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ]
        }
      },
      "required": [
        "contract_version",
        "kind",
        "error"
      ]
    }
  }
}
