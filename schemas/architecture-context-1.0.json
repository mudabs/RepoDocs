{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repodocs.invalid/schemas/architecture-context-1.0.json",
  "title": "RepoDocs architecture-discovery context bundle",
  "description": "The redacted, bounded source context a provider receives for architecture discovery (ADR-026). Written to .repodocs/architecture-context.json before any provider is contacted, so it can be reviewed. Holds redacted excerpts, never the unredacted originals.",
  "type": "object",
  "required": ["context_version", "policy", "source_ir_hash", "snapshots", "inventory", "index", "coverage", "documents", "omitted", "omitted_counts", "omitted_truncated", "usage", "redaction"],
  "additionalProperties": false,
  "$defs": {
    "directoryCounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["directory", "count"],
        "additionalProperties": false,
        "properties": {"directory": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}
      }
    }
  },
  "properties": {
    "context_version": {"const": "1.0"},
    "source_ir_hash": {"type": "string", "minLength": 1},
    "policy": {
      "type": "object",
      "required": ["selection_version", "redaction_version", "budgets"],
      "additionalProperties": false,
      "properties": {
        "selection_version": {"type": "string", "minLength": 1},
        "redaction_version": {"type": "string", "minLength": 1},
        "budgets": {
          "type": "object",
          "required": ["max_rounds", "max_requests", "max_files_per_round", "max_excerpt_bytes", "max_file_bytes", "max_context_bytes", "max_response_bytes", "max_inventory_paths"],
          "additionalProperties": false,
          "properties": {
            "max_rounds": {"type": "integer", "minimum": 1},
            "max_requests": {"type": "integer", "minimum": 1},
            "max_files_per_round": {"type": "integer", "minimum": 1},
            "max_excerpt_bytes": {"type": "integer", "minimum": 1},
            "max_file_bytes": {"type": "integer", "minimum": 1},
            "max_context_bytes": {"type": "integer", "minimum": 1},
            "max_response_bytes": {"type": "integer", "minimum": 1},
            "max_inventory_paths": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository_id", "revision", "revision_kind", "content_fingerprint"],
        "additionalProperties": false,
        "properties": {
          "repository_id": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1},
          "revision_kind": {"enum": ["commit", "content"]},
          "content_fingerprint": {"type": "string", "minLength": 1}
        }
      }
    },
    "inventory": {
      "type": "array",
      "description": "Directory and file names only, bounded by max_inventory_paths and a share of max_context_bytes. Assets and crowded directories are counted, not listed.",
      "items": {
        "type": "object",
        "required": ["repository_id", "paths", "truncated", "more_files", "assets"],
        "additionalProperties": false,
        "properties": {
          "repository_id": {"type": "string", "minLength": 1},
          "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "truncated": {"type": "boolean"},
          "more_files": {"description": "Files a directory holds beyond those listed.", "$ref": "#/$defs/directoryCounts"},
          "assets": {"description": "Image, font, media and archive files per directory, never listed individually.", "$ref": "#/$defs/directoryCounts"}
        }
      }
    },
    "index": {
      "type": "object",
      "description": "Static import statements found in opened files. Not runtime order, calls, or data flow, and nothing about unopened files.",
      "required": ["note", "files", "truncated"],
      "additionalProperties": false,
      "properties": {
        "note": {"type": "string"},
        "truncated": {"type": "boolean"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repository_id", "path", "content_hash", "references"],
            "additionalProperties": false,
            "properties": {
              "repository_id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "content_hash": {"type": "string", "minLength": 1},
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["line", "specifier", "target", "status"],
                  "additionalProperties": false,
                  "properties": {
                    "line": {"type": "integer", "minimum": 1},
                    "specifier": {"type": "string"},
                    "target": {"type": ["string", "null"]},
                    "status": {"enum": ["read", "excerpted", "unopened", "unresolved"], "description": "read: the whole file is in the context; excerpted: a span of it; unopened: in the snapshot but not in the context; unresolved: names no snapshot file."}
                  }
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "description": "What each repository's context covers and what it lacks.",
      "items": {
        "type": "object",
        "required": ["repository_id", "candidate_files", "opened_files", "layers", "missing_layers", "unopened_priority"],
        "additionalProperties": false,
        "properties": {
          "repository_id": {"type": "string", "minLength": 1},
          "candidate_files": {"type": "integer", "minimum": 0},
          "opened_files": {"type": "integer", "minimum": 0},
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["layer", "files", "opened"],
              "additionalProperties": false,
              "properties": {
                "layer": {"enum": ["backend", "frontend", "storage", "other"]},
                "files": {"type": "integer", "minimum": 1},
                "opened": {"type": "integer", "minimum": 0}
              }
            }
          },
          "missing_layers": {"type": "array", "description": "Layers with candidate files by name and location, none of them in the context.", "items": {"enum": ["backend", "frontend", "storage"]}},
          "unopened_priority": {"type": "array", "description": "The best-ranked candidate files that are not in the context.", "items": {"type": "string"}}
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repository_id", "path", "content_hash", "kind", "line_start", "line_end", "text", "redactions", "truncated"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^ctx:[0-9a-f]{16}$"},
          "repository_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "minLength": 1},
          "kind": {"enum": ["readme", "manifest", "config", "source"]},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "text": {"type": "string"},
          "redactions": {"type": "integer", "minimum": 0},
          "truncated": {"type": "boolean"},
          "requested_in_round": {"type": "integer", "minimum": 0}
        }
      }
    },
    "omitted": {
      "type": "array",
      "description": "What was left out and why, without the content. Material reasons come first and the list is bounded.",
      "items": {
        "type": "object",
        "required": ["reason"],
        "additionalProperties": false,
        "properties": {
          "repository_id": {"type": "string"},
          "path": {"type": "string"},
          "reason": {"enum": ["denied-name", "binary", "too-large", "not-text", "stale", "outside-repository", "not-in-snapshot", "budget-exhausted", "duplicate", "unreadable"]}
        }
      }
    },
    "omitted_counts": {"type": "object", "description": "Omissions per reason, including those cut from the omitted list.", "additionalProperties": {"type": "integer", "minimum": 1}},
    "omitted_truncated": {"type": "boolean", "description": "The omitted list was cut, to its entry limit or to keep the total within max_context_bytes. It is the lowest-priority part of the context."},
    "usage": {
      "type": "object",
      "required": ["rounds", "requests", "context_bytes", "metadata_bytes", "reserved_bytes"],
      "additionalProperties": false,
      "properties": {
        "rounds": {"type": "integer", "minimum": 0},
        "requests": {"type": "integer", "minimum": 0},
        "context_bytes": {"type": "integer", "minimum": 0, "description": "Documents as they appear in a request: JSON inside the user message, itself encoded as a JSON string."},
        "metadata_bytes": {"type": "integer", "minimum": 0, "description": "Inventory, index, coverage and omissions, measured the same way."},
        "reserved_bytes": {"type": "integer", "minimum": 0, "description": "Room kept for the instructions. A document is admitted only while context_bytes + metadata_bytes + reserved_bytes fits max_context_bytes, and the omitted list is cut to keep it there. Discovery still measures each complete request before sending it."}
      }
    },
    "redaction": {
      "type": "object",
      "required": ["rules_version", "replacements"],
      "additionalProperties": false,
      "properties": {
        "rules_version": {"type": "string"},
        "replacements": {"type": "integer", "minimum": 0}
      }
    }
  }
}
