{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repodocs.dev/schemas/artifact-manifest-1.0.json",
  "title": "RepoDocs generated artifact manifest",
  "type": "object",
  "required": ["manifest_version", "ownership", "destination", "source_ir_hash", "generator", "generator_version", "artifacts"],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "ownership": {"const": "repodocs-generated"},
    "destination": {
      "type": "object",
      "description": "The repository that owns the generated output, as configured at generation time. It omits the destination's own Git revision and tree state, which change with every documentation commit.",
      "required": ["repository_id", "role", "path", "output_directory", "pinned_revision"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["source", "destination"]},
        "path": {"type": "string", "minLength": 1},
        "output_directory": {"type": "string", "minLength": 1},
        "pinned_revision": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "source_ir_hash": {"type": "string", "minLength": 1},
    "generator": {"type": "string", "minLength": 1},
    "generator_version": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "content_hash", "source_ir_hash", "generator", "generator_version"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "minLength": 1},
          "source_ir_hash": {"type": "string", "minLength": 1},
          "generator": {
            "enum": ["repodocs-deterministic", "repodocs-ai"],
            "description": "repodocs-ai marks an artifact rendered from validated model claims; every other artifact contains no model output."
          },
          "generator_version": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
