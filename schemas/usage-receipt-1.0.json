{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repodocs.dev/schemas/usage-receipt-1.0.json",
  "title": "RepoDocs model usage receipt",
  "description": "A local record of one run's model requests, limits and usage. It holds counts and outcomes only, never a prompt, a response or a credential. A null token count was not reported by the provider and is not zero. Charged totals count a request without complete usage at its reserved worst case, so they are upper bounds. A byte-bound is one token per UTF-8 byte of the serialized request plus framing; it bounds byte-level and byte-fallback tokenizers and is not a token count. Token-count requests are counted separately and not priced.",
  "type": "object",
  "required": [
    "receipt_version", "run_id", "command", "recorded_at", "provider", "requested_model", "external", "limits",
    "price_profile", "max_estimated_cost_usd", "requests", "totals", "remaining", "stop_reason", "stop_message", "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "receipt_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "requested_model": {"type": "string", "minLength": 1},
    "external": {"type": "boolean"},
    "limits": {
      "type": "object",
      "description": "The effective limits for the run, with defaults and ceilings applied.",
      "required": ["context_window_tokens", "request_output_tokens", "max_requests", "max_count_requests", "max_input_tokens", "max_output_tokens"],
      "additionalProperties": false,
      "properties": {
        "context_window_tokens": {"type": "integer", "minimum": 1},
        "request_output_tokens": {"type": "integer", "minimum": 1},
        "max_requests": {"type": "integer", "minimum": 1},
        "max_count_requests": {"type": "integer", "minimum": 1},
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_total_tokens": {"type": "integer", "minimum": 1},
        "max_cost_usd": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "price_profile": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["version", "provider", "model", "input_usd_per_mtok", "output_usd_per_mtok"],
          "additionalProperties": false,
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "served_models": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "input_usd_per_mtok": {"type": "number", "minimum": 0},
            "output_usd_per_mtok": {"type": "number", "minimum": 0},
            "cache_read_usd_per_mtok": {"type": "number", "minimum": 0},
            "cache_write_usd_per_mtok": {"type": "number", "minimum": 0}
          }
        }
      ]
    },
    "max_estimated_cost_usd": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{6}$"},
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index", "outcome", "served_model", "estimate_tokens", "estimate_method", "output_cap_tokens", "usage", "usage_measured",
          "exceeded_reservation", "charged_input_tokens", "charged_output_tokens", "reserved_cost_usd", "charged_cost_usd", "cost_measured"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "outcome": {"enum": ["in-flight", "ok", "provider-error", "interrupted"]},
          "served_model": {"type": ["string", "null"]},
          "estimate_tokens": {"type": "integer", "minimum": 0},
          "estimate_method": {"enum": ["provider-count", "byte-bound"]},
          "output_cap_tokens": {"type": "integer", "minimum": 1},
          "usage": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "reasoning_tokens"],
                "additionalProperties": false,
                "properties": {
                  "input_tokens": {"type": ["integer", "null"], "minimum": 0},
                  "output_tokens": {"type": ["integer", "null"], "minimum": 0},
                  "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
                  "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0},
                  "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0}
                }
              }
            ]
          },
          "usage_measured": {"type": "boolean"},
          "exceeded_reservation": {"type": "boolean", "description": "Reported usage was larger than the reserved prompt bound or output cap."},
          "charged_input_tokens": {"type": "integer", "minimum": 0},
          "charged_output_tokens": {"type": "integer", "minimum": 0},
          "reserved_cost_usd": {"type": ["string", "null"]},
          "charged_cost_usd": {"type": ["string", "null"]},
          "cost_measured": {"type": "boolean"}
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["requests", "count_requests", "input_tokens", "output_tokens", "cost_usd", "unmeasured_requests", "usage_complete"],
      "additionalProperties": false,
      "properties": {
        "requests": {"type": "integer", "minimum": 0},
        "count_requests": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": ["string", "null"]},
        "unmeasured_requests": {"type": "integer", "minimum": 0},
        "usage_complete": {"type": "boolean"}
      }
    },
    "remaining": {
      "type": "object",
      "required": ["requests", "count_requests", "input_tokens", "output_tokens", "cost_usd"],
      "additionalProperties": false,
      "properties": {
        "requests": {"type": "integer", "minimum": 0},
        "count_requests": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["string", "null"]}
      }
    },
    "stop_reason": {"enum": [null, "cancelled", "request-limit", "context-window", "input-token-limit", "output-token-limit", "total-token-limit", "cost-limit", "reported-usage-over-limit", "unpriced-usage"]},
    "stop_message": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
